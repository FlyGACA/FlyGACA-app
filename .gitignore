# Dependencies
node_modules/

# Build output
dist/
dev-dist/
*.tsbuildinfo

# Swift build output — defensive guard so a nested .build/ at any depth can
# never be committed (the retired apple/ mirror's apple/FlyGACAKit/.build/ once
# slipped past a too-specific `apple/.build/` pattern). Native apps now live in
# the ay2m/FlyGACA repo.
**/.build/

# Generated by build:sitemap (scripts/build-sitemap.mjs) on every `npm run build`.
# Committing them caused recurring merge conflicts on regenerated lastmod dates;
# the build always regenerates them into public/ → dist/.
public/sitemap.xml
public/robots.txt

# Coverage reports
coverage/

# Playwright
test-results/
playwright-report/
blob-report/
/playwright/.cache/

# Capacitor platform projects are generated on the Mac, never committed — and
# the per-flavor pipeline (scripts/flavor-ios.mjs) regenerates ios/ for ONE
# flavor at a time, so a committed project would always be the wrong app.
# See docs/RUNBOOK-native.md.
/ios/
/android/

# Xcode user state / caches
xcuserdata/
*.xcuserstate
DerivedData/

# Per-flavor staged public dir (built by scripts/build-flavor.mjs)
.flavor/

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
*.local

# Env
.env
.env.local
.env.*.local

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log

# Cloudflare Wrangler (local dev cache + state)
.wrangler/

# Logs
npm-debug.log*
*.log
.vercel

# GACA sync — fetched source HTML/PDF assets (regenerated on demand)
sync-input/assets/

# Generated Captain Adel source art (regenerate via npm run gen:captain) — kept out of the deploy
captain-art/

# Python bytecode (skill helper scripts)
__pycache__/
*.py[cod]

# iOS content-generation scratch output (native apps live in ay2m/FlyGACA)
.ios-build/
