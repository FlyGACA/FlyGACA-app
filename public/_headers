# Static-response headers, copied verbatim into dist/ by Vite. Honored natively by
# the Cloudflare Workers static-assets layer and by Netlify.
#
# This file is AUTHORITATIVE for the Cloudflare front. `run_worker_first` in
# wrangler.toml is scoped to "/api/*", so worker/index.ts never runs for a static
# path and physically cannot set headers there — the asset layer does, from here.
# Keep this CSP byte-identical to firebase.json, vercel.json and netlify.toml;
# tests/csp-parity.test.ts fails the build if the four drift.
#
# There is deliberately NO `X-Robots-Tag: noindex` here any more. Cloudflare now
# serves the CANONICAL flygaca.com, and `_headers` has no host-conditional syntax
# to exempt it. The mirror fronts noindex in their own config instead (netlify.toml
# unconditionally, vercel.json via a `missing: host` rule), and the Worker publishes
# no second hostname (`workers_dev = false` / `preview_urls = false`).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.gstatic.com https://www.google.com https://apis.google.com https://cdn.moyasar.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.moyasar.com; img-src 'self' data: blob: https://*.googleusercontent.com https://www.gstatic.com https://storage.googleapis.com https://firebasestorage.googleapis.com https://cdn.moyasar.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://*.googleapis.com wss://*.googleapis.com https://me-central1-flygaca-app.cloudfunctions.net https://www.google.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://api.moyasar.com; frame-src 'self' https://*.firebaseapp.com https://www.google.com https://apis.google.com https://accounts.google.com https://api.moyasar.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'; upgrade-insecure-requests

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=3600

/sw.js
  Cache-Control: no-cache

# Apple Pay merchant-domain association. Served as plain text, byte-for-byte, and
# short-cached so a re-issued token propagates without a redeploy. See docs/BILLING.md.
/.well-known/*
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

# Serve the crawl/AI-discovery files as text/xml, never as the SPA HTML fallback.
/robots.txt
  Content-Type: text/plain; charset=utf-8

/llms.txt
  Content-Type: text/plain; charset=utf-8

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
